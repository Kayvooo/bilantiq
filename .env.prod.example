# Konfiguration fuer Ihre eigene Instanz (docker-compose.prod.yml). Schritt-fuer-Schritt: docs/self-hosting.md.
# Kopieren nach .env.prod (gitignored) und die Werte anpassen. Start:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Die Beispieldomains (example.org) sind Platzhalter: eigene Domain eintragen.

# --- Secret-Dateien ---
# Nicht in diese Datei schreiben. ./scripts/init-secrets.sh erzeugt lokale root-only
# Dateien; auf Produktion vorzugsweise /opt/bilantiq/secrets verwenden.
BILANTIQ_SECRETS_DIR=/opt/bilantiq/secrets

# --- Postgres (Container) ---
POSTGRES_USER=bilantiq
POSTGRES_DB=bilantiq
# Passwort kommt aus postgres_password. database_url enthaelt eine eigene unprivilegierte API-Rolle;
# migration_database_url bleibt nur beim einmaligen Dienst migrate. Siehe docs/security-runtime.md.

# Aktiver AES-GCM-Key. Das Keymaterial selbst liegt in /run/secrets/data_encryption_keys.
DATA_ENCRYPTION_ACTIVE_KID=v1

# --- Domains / CORS / Host-Schutz ---
# APP_ENV=production: die App startet nicht, wenn TRUSTED_HOSTS_RAW fehlt oder '*' enthaelt.
APP_ENV=production
# Domains fuer den Reverse-Proxy (Caddyfile): Oberflaeche und API, beide per DNS auf diesen Server.
APP_DOMAIN=buchhaltung.example.org
API_DOMAIN=api.buchhaltung.example.org
CORS_ALLOWED_ORIGINS_RAW=https://buchhaltung.example.org
TRUSTED_HOSTS_RAW=api.buchhaltung.example.org
# Basis-URL fuer Links in E-Mails (Passwort zuruecksetzen); muss die echte Frontend-Adresse sein.
APP_FRONTEND_URL=https://buchhaltung.example.org
# Build-Zeit-Wert fuers Frontend-Bundle (oeffentliche API-Adresse):
VITE_API_BASE_URL=https://api.buchhaltung.example.org

# --- Dateispeicher ---
# Alle Belege, Logos, Briefpapier, Kontoauszuege und das Altrechnungs-Archiv liegen unter STORAGE_DIR im Backend-
# Container, gehalten vom Docker-Volume backend_data. Normalerweise nicht aendern.
STORAGE_DIR=/app/data

# --- Registrierung ---
# first_account: nur das erste Konto darf sich selbst registrieren, weitere Personen per Einladungscode (empfohlen).
# closed: keine Selbstregistrierung; open: jede Person darf eine Firma anlegen (nur fuer bewusst oeffentliche Instanzen).
REGISTRATION_MODE=first_account

# --- SMTP (optional: E-Mail-Versand von Rechnungen/Mahnungen und "Passwort vergessen") ---
# Leer lassen = E-Mail abgeschaltet, die App startet trotzdem. Zum Einschalten alle Werte setzen und das Passwort in
# der Secret-Datei smtp_password hinterlegen (nicht hier). Ohne E-Mail: Konto-Wiederherstellung per Skript, siehe
# docs/self-hosting.md.
SMTP_HOST=
SMTP_USER=
SMTP_PORT=587
SMTP_ABSENDER=

# --- Lokale KI (self-hosted, kein externer Fallback) ---
AI_ENABLED=false
AI_BASE_URL=http://ai:8000/v1
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=30
AI_API_KEY=
