# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=sqlite:///./bilantiq_dev.db
JWT_SECRET=generate-with-openssl-rand-hex-32
FIELD_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
EMAIL_LOOKUP_SECRET=generate-with-openssl-rand-hex-32
# AES-256-GCM keyring; generate 32 random bytes and encode urlsafe-base64 without padding.
DATA_ENCRYPTION_KEYS=v1:generate-with-python-secrets-base64
DATA_ENCRYPTION_ACTIVE_KID=v1
BLIND_INDEX_SECRET=generate-with-python-secrets-token-url-safe
# Basis-URL des Frontends fuer Links in E-Mails (Passwort zuruecksetzen). Ohne Wert werden keine Reset-Mails erzeugt.
APP_FRONTEND_URL=http://localhost:5173
# SMTP ist OPTIONAL. Ohne die vier Werte unten startet die App trotzdem; dann sind der E-Mail-Versand von Rechnungen/
# Angeboten/Mahnungen und "Passwort vergessen" abgeschaltet und melden das verstaendlich (HTTP 503). PDFs lassen sich
# weiterhin herunterladen. Wiederherstellungsweg ohne E-Mail: docs/self-hosting.md.
# Jeder SMTP-Anbieter mit STARTTLS geht, z.B. ein Konto mit App-Passwort oder ein transaktionaler SMTP-Relay-Dienst.
# STARTTLS ist Pflicht und das Serverzertifikat wird geprueft (oeffentliche CA, Hostname muss passen);
# ein lokaler Test-SMTP mit selbstsigniertem Zertifikat wird abgelehnt. Siehe docs/email-zustellung.md.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=replace-with-your-smtp-username
# SMTP_PASSWORD=replace-with-your-smtp-password
# Absenderadresse; ohne Angabe wird SMTP_USER verwendet, falls es eine Adresse ist. Eine Adresse Ihrer eigenen Domain
# verwenden (SPF/DKIM einrichten), nie eine fremde.
# SMTP_ABSENDER=rechnung@example.org

# --- Dateispeicher ---
# Basisordner fuer ALLE Dateien dieser Instanz (Belege, Logos, Briefpapier, Kontoauszuege, Altrechnungs-Archiv).
# Standard ./data (relativ zum Backend-Ordner, in .gitignore). Jede Instanz braucht ihren eigenen dauerhaften Speicher
# und ein Backup davon, siehe docs/self-hosting.md. Beim Start wird der Ordner angelegt und auf Schreibbarkeit geprueft.
# STORAGE_DIR=./data

# --- Registrierung ---
# first_account (Standard): nur das allererste Konto darf sich selbst registrieren, weitere Personen per Einladungscode.
# open: jede Person darf eine neue Firma anlegen (nur fuer bewusst oeffentliche Instanzen).
# closed: keine Selbstregistrierung, der Inhaber legt Mitglieder direkt an.
# REGISTRATION_MODE=first_account

# Interaktive API-Doku (/docs, /redoc) nur lokal einschalten; in Produktion aus lassen (Standard).
API_DOCS_AKTIV=true

# --- Lokale KI (optional, standardmaessig aus) ---
AI_ENABLED=false
AI_BASE_URL=http://ai:8000/v1
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=30
# Optional fuer einen internen Gateway; bei direktem lokalen Server leer lassen.
AI_API_KEY=

# Versandlimit je Mandant fuer Rechnungen/Angebote/Mahnungen per E-Mail (0 = aus) und Reply-To = Anmelde-Adresse des Nutzers.
# EMAIL_LIMIT_PRO_STUNDE=30
# EMAIL_LIMIT_PRO_TAG=100
# EMAIL_REPLY_TO_NUTZER=true

# --- XRechnung-Pruefung (siehe docs/xrechnung-validierung.md) ---
# aus | warnen | blockieren. "warnen" liefert das XML mit Pruef-Headern aus; "blockieren" stoppt bei Fehlern (HTTP 422)
# und auch dann, wenn die Regeln fehlen. Regeln holen: python scripts/kosit_regeln_holen.py
# XRECHNUNG_PRUEFUNG=warnen
# XRECHNUNG_REGELN_DIR=
