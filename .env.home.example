# Konfiguration fuer den Heimserver-Betrieb (docker-compose.home.yml). Anleitung: docs/heimserver-tailscale.md.
# Kopieren nach .env.home (gitignored) und den Namen anpassen. Start:
#   docker compose --env-file .env.home -f docker-compose.home.yml up -d --build

# --- Secret-Dateien ---
# Nicht in diese Datei schreiben. ./scripts/init-secrets.sh erzeugt die Dateien. Fuer den Heimbetrieb ein Ordner in Ihrem
# Benutzerverzeichnis (Dateien gehoeren Ihnen, Rechte 0600), z. B. /home/IHR-NAME/.config/bilantiq/secrets
BILANTIQ_SECRETS_DIR=/home/IHR-NAME/.config/bilantiq/secrets

# --- Postgres (Container) ---
POSTGRES_USER=bilantiq
POSTGRES_DB=bilantiq
DATA_ENCRYPTION_ACTIVE_KID=v1

# --- Adresse ---
# Der Name Ihres Rechners im VPN (Tailscale: "tailscale status" bzw. die Adresse aus "tailscale serve status", Form
# rechner.tailnet-name.ts.net). Ohne https://. localhost/127.0.0.1 erlauben den Zugriff auf dem Rechner selbst.
APP_ENV=production
TRUSTED_HOSTS_RAW=rechner.tailnet-name.ts.net,localhost,127.0.0.1
# Oberflaeche und API haben dieselbe Adresse; CORS betrifft nur andere Adressen. Trotzdem den echten Namen eintragen.
CORS_ALLOWED_ORIGINS_RAW=https://rechner.tailnet-name.ts.net
# Basis-URL fuer Links in E-Mails (Passwort zuruecksetzen), nur relevant, wenn SMTP eingerichtet ist.
APP_FRONTEND_URL=https://rechner.tailnet-name.ts.net

# --- Dateispeicher ---
STORAGE_DIR=/app/data

# --- Registrierung ---
# first_account: nur das erste Konto registriert sich selbst, weitere Personen per Einladungscode (empfohlen).
REGISTRATION_MODE=first_account

# Zwei-Faktor-Pflicht: owner (Standard) oder alle. "aus" ist in Produktion nicht erlaubt.
MFA_PFLICHT=owner

# --- SMTP (optional) ---
# Leer lassen = E-Mail abgeschaltet. Ohne E-Mail: Konto-Wiederherstellung per Skript, siehe docs/self-hosting.md.
SMTP_HOST=
SMTP_USER=
SMTP_PORT=587
SMTP_ABSENDER=

# --- Lokale KI (self-hosted, kein externer Fallback) ---
AI_ENABLED=false
AI_BASE_URL=http://ai:8000/v1
AI_MODEL=local-model
AI_TIMEOUT_SECONDS=30
AI_API_KEY=
